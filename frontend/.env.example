# ==============================================================================
# HYDERABAD CUE SPORTS - SUPABASE ENVIRONMENT VARIABLES
# ==============================================================================
# Duplicate this file to .env.local and populate with your credentials from:
# Supabase Dashboard -> Project Settings -> API

# Public API URL & Anon Key (Accessible in both browser & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service Role Secret Key (Server-Only, NEVER expose with NEXT_PUBLIC_)
# Used for backend webhooks, admin dashboard actions, and bypassing RLS when required
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Direct PostgreSQL Connection String (Optional, for direct migrations/Prisma)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Fastify Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Cloudflare Turnstile Site Key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Hyderabad Cue Sports Storefront Public Base URL (no trailing slash)
# Used for constructing canonical query-parameterized product and catalog URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

